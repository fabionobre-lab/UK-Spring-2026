{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npm --prefix web test || exit 2",
            "shell": "bash",
            "timeout": 120,
            "statusMessage": "Running vitest suite before stopping..."
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm test)",
      "Bash(npm --prefix web run *)",
      "Bash(npm --prefix web test)",
      "Bash(npx vitest *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "mcp__github__pull_request_read",
      "mcp__github__actions_list",
      "mcp__github__get_file_contents",
      "mcp__github__get_check_run",
      "mcp__github__get_job_logs",
      "mcp__github__list_pull_requests",
      "mcp__github__list_commits",
      "mcp__github__list_branches",
      "mcp__github__search_code"
    ],
    "deny": [
      "Bash(npm run deploy)"
    ]
  }
}
